# PostgreSQL
POSTGRES_DB=armory_ledger
POSTGRES_USER=armory_ledger
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenID Connect (OIDC)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=https://armory.example.com/auth/callback

# Application session signing
SESSION_SECRET=

# Optional identity/contact information for this installation.
# Leave blank to omit the corresponding About / Privacy information.
ARMORY_OPERATOR_NAME=
ARMORY_SUPPORT_EMAIL=
ARMORY_SUPPORT_URL=
