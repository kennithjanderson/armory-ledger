# PostgreSQL — the setup script generates POSTGRES_PASSWORD on a fresh install.
POSTGRES_DB=armory_ledger
POSTGRES_USER=armory_ledger
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenID Connect (OIDC) — required operator-supplied identity-provider values.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=

# Application session signing — generated on a fresh install.
SESSION_SECRET=

# Optional identity/contact information for this installation.
# Leave blank to omit the corresponding About / Privacy information.
ARMORY_OPERATOR_NAME=
ARMORY_SUPPORT_EMAIL=
ARMORY_SUPPORT_URL=

# Backup operations. The setup script generates the encryption key on a fresh
# install. The Compose bind mount persists ./data/backups across container
# recreation. Automatic scheduling remains disabled until enabled in Admin.
ARMORY_BACKUP_DIR=/var/lib/armory/backups
ARMORY_TIMEZONE=UTC
ARMORY_WORKER_ENABLED=true
ARMORY_BACKUP_MAX_BYTES=2147483648
# Required for backup, import and restore. Canonical URL-safe base64 of exactly
# 32 random bytes (AES-256-GCM). Preserve a protected copy off-host; never replace
# a key while its archives may be needed.
ARMORY_BACKUP_ENCRYPTION_KEY=
# Separate Fernet key used only to encrypt the SMTP password stored in the
# application database. It is not the backup key. The setup script generates it
# on a fresh install; preserve it if SMTP credentials have already been saved.
ARMORY_SECRET_KEY=
