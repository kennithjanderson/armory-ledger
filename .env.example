# PostgreSQL
POSTGRES_DB=armory_ledger
POSTGRES_USER=armory_ledger
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenID Connect (OIDC)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=https://armory.example.com/auth/callback

# Application session signing
SESSION_SECRET=

# Optional identity/contact information for this installation.
# Leave blank to omit the corresponding About / Privacy information.
ARMORY_OPERATOR_NAME=
ARMORY_SUPPORT_EMAIL=
ARMORY_SUPPORT_URL=

# Backup operations: persistent private directory, explicit daily timezone; schedule disabled initially.
ARMORY_BACKUP_DIR=/var/lib/armory/backups
ARMORY_TIMEZONE=UTC
ARMORY_WORKER_ENABLED=true
ARMORY_BACKUP_MAX_BYTES=2147483648
# Required for manual/scheduled backups, archive import and restore. URL-safe base64
# encoding of exactly 32 random bytes (AES-256-GCM). Generate with:
# python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# Store a protected copy outside this server. Never rotate this key while archives
# encrypted with it must remain recoverable.
ARMORY_BACKUP_ENCRYPTION_KEY=
# Separate Fernet key used only for stored SMTP passwords. It is not the backup key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARMORY_SECRET_KEY=
